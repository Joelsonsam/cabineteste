<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EstacaoImpressao</AssemblyName>
    <RootNamespace>Cabine.Estacao</RootNamespace>
    <ApplicationIcon>estacao.ico</ApplicationIcon>
    <Product>Estação de impressão - Cabine Mude!</Product>
    <Company>Mude! Agência de Live Marketing</Company>
    <Copyright>Joelson Sampaio · joelsonsam@gmail.com</Copyright>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="teste/**" />
  </ItemGroup>
</Project>
